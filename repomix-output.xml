<file path="src/app/page.tsx">
'use client';

import { useState, useEffect, useRef } from 'react';
import { useRouter } from 'next/navigation';
import Link from 'next/link';
import { ChevronRight, ChevronLeft, ShoppingCart, MessageCircle } from 'lucide-react';
import { HeroCarousel } from '@/components/HeroCarousel';
import { CategoryDock } from '@/components/CategoryDock';
import { OffersCarousel } from '@/components/OffersCarousel';
import { productService } from '@/services/productService';
import type { Product } from '@/data/products';
import { siteConfig } from '@/config/site';
import { useCartStore } from '@/store/cartStore';

// El diagrama industrial fondo oscuro (#0A0E17) que te gusta como backup
const FALLBACK_INDUSTRIAL_SVG =
  'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" fill="none"><rect width="400" height="400" rx="32" fill="%230A0E17"/><circle cx="200" cy="200" r="120" stroke="%230044FF" stroke-width="4" stroke-dasharray="12 12" opacity="0.5"/><circle cx="200" cy="200" r="85" fill="%230044FF" fill-opacity="0.15" stroke="%2300E5FF" stroke-width="3"/><path d="M215 115L145 215H200L185 285L255 185H200L215 115Z" fill="%2300E5FF" stroke="%23FFFFFF" stroke-width="4" stroke-linejoin="round"/><text x="200" y="355" text-anchor="middle" fill="%2300E5FF" font-family="sans-serif" font-weight="900" font-size="18" letter-spacing="4">ENERGY KVA</text></svg>';

const ProductCarousel = ({
  title,
  products,
  categoryId,
  formatPrice,
  handleAddToCart,
}: {
  title: string;
  products: Product[];
  categoryId: string;
  formatPrice: (p: number) => string;
  handleAddToCart: (p: Product) => void;
}) => {
  const router = useRouter();
  const scrollRef = useRef<HTMLDivElement>(null);

  const scroll = (direction: 'left' | 'right') => {
    if (scrollRef.current) {
      const scrollAmount = 320;
      scrollRef.current.scrollBy({
        left: direction === 'left' ? -scrollAmount : scrollAmount,
        behavior: 'smooth',
      });
    }
  };

  const generateWaLink = (product: Product) => {
    const cleanPhone = String(siteConfig.contact.whatsapp).replace(/\D/g, '');
    const text = `Hola ENERGY KVA. Deseo consultar disponibilidad del equipo:\n\n📦 *${product.title}*\n🔹 Código: #${product.id}\n\nQuedo atento.`;
    return `https://wa.me/${cleanPhone}?text=${encodeURIComponent(text)}`;
  };

  return (
    <section className="w-full px-2 sm:px-6 md:px-12 lg:px-16 xl:px-20 py-6 md:py-8">
      <div className="flex items-center justify-between mb-2 px-2">
        <h2 className="text-xl sm:text-2xl md:text-3xl font-black text-[#0f1115] tracking-tight uppercase drop-shadow-sm">
          {title}
        </h2>
        <Link
          href={
            categoryId === 'Todos'
              ? '/catalogo'
              : `/catalogo?category=${encodeURIComponent(categoryId)}`
          }
          className="text-[10px] sm:text-xs font-black text-blue-600 flex items-center gap-1 hover:text-blue-500 transition-colors uppercase tracking-wider"
        >
          Ver todos <ChevronRight className="w-4 h-4" />
        </Link>
      </div>

      <div className="relative w-full flex items-center">
        {/* Flecha Izquierda Fija */}
        <button
          type="button"
          onClick={() => scroll('left')}
          aria-label="Anterior"
          className="absolute left-0 sm:-left-4 top-1/2 -translate-y-1/2 z-30 w-8 h-8 sm:w-10 sm:h-10 rounded-full liquid-glass-dark text-cyan-400 hover:text-white flex items-center justify-center cursor-pointer shadow-md active:scale-95"
        >
          <ChevronLeft className="w-4 h-4 sm:w-5 sm:h-5" />
        </button>

        {/* Pista del Carrusel (Márgenes corregidos para móvil) */}
        <div
          ref={scrollRef}
          className="flex overflow-x-auto gap-3 sm:gap-5 py-6 scrollbar-hide snap-x px-8 sm:px-10 w-full scroll-smooth"
        >
          {products.map((prod) => (
            <div
              key={prod.id}
              className="snap-start flex-shrink-0 w-[240px] sm:w-[260px] md:w-[280px]"
            >
              <div
                className="liquid-glass-pearl h-full flex flex-col p-4 relative group/card cursor-pointer"
                onClick={() => router.push(`/product/${prod.id}`)}
              >
                {/* Contenedor de Imagen (Ahora con esquinas apenas redondeadas rounded-xl en lugar de 2xl o full) */}
                <div className="relative w-full aspect-square rounded-xl bg-white flex items-center justify-center mb-4 overflow-hidden border border-slate-100 shadow-sm">
                  <img
                    src={prod.images[0] || FALLBACK_INDUSTRIAL_SVG}
                    alt={prod.title}
                    onError={(e) => {
                      e.currentTarget.onerror = null;
                      e.currentTarget.src = FALLBACK_INDUSTRIAL_SVG;
                    }}
                    className="w-full h-full object-contain p-4 group-hover/card:scale-105 transition-transform duration-300"
                  />
                  {prod.badge && (
                    <span className="absolute top-2 left-2 px-2.5 py-1 rounded-md text-[9px] font-black uppercase tracking-wider liquid-glass-dark text-cyan-300">
                      {prod.badge}
                    </span>
                  )}
                </div>

                <span className="text-[9px] font-black text-blue-600 uppercase tracking-widest mb-1">
                  {prod.category}
                </span>

                <h3 className="text-xs sm:text-sm font-bold text-[#0f1115] line-clamp-2 mb-2 leading-snug group-hover/card:text-blue-700 transition-colors">
                  {prod.title}
                </h3>

                <div className="mt-auto mb-4">
                  <span className="text-lg sm:text-xl md:text-2xl font-black text-[#0f1115] truncate tracking-tight">
                    {formatPrice(prod.price)}
                  </span>
                </div>

                <div className="flex items-center gap-2 pt-3 border-t border-slate-200">
                  <button
                    type="button"
                    onClick={(e) => {
                      e.stopPropagation();
                      handleAddToCart(prod);
                    }}
                    className="flex-1 liquid-glass-active text-white text-[10px] font-black py-2.5 rounded-lg flex items-center justify-center gap-2 uppercase tracking-wider hover:brightness-110 cursor-pointer"
                  >
                    <ShoppingCart className="w-3.5 h-3.5" /> Añadir
                  </button>
                  <a
                    href={generateWaLink(prod)}
                    onClick={(e) => e.stopPropagation()}
                    target="_blank"
                    rel="noreferrer"
                    className="w-9 h-9 flex-shrink-0 liquid-glass-dark text-slate-200 hover:text-emerald-400 rounded-lg flex items-center justify-center transition-colors cursor-pointer"
                    title="Consultar por WhatsApp"
                  >
                    <MessageCircle className="w-4 h-4" />
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>

        {/* Flecha Derecha Fija */}
        <button
          type="button"
          onClick={() => scroll('right')}
          aria-label="Siguiente"
          className="absolute right-0 sm:-right-4 top-1/2 -translate-y-1/2 z-30 w-8 h-8 sm:w-10 sm:h-10 rounded-full liquid-glass-dark text-cyan-400 hover:text-white flex items-center justify-center cursor-pointer shadow-md active:scale-95"
        >
          <ChevronRight className="w-4 h-4 sm:w-5 sm:h-5" />
        </button>
      </div>
    </section>
  );
};

export default function HomePage() {
  const router = useRouter();
  const { currency, bcvRate, usdtRate, addItem, toggleCart } = useCartStore();

  const [featuredProducts, setFeaturedProducts] = useState<Product[]>([]);
  const [catalogProducts, setCatalogProducts] = useState<Product[]>([]);
  const [selectedCategory, setSelectedCategory] = useState<string>('Todos');

  useEffect(() => {
    const loadProducts = async () => {
      const all = await productService.getProducts();
      setFeaturedProducts(all.slice(0, 8));
      setCatalogProducts([...all].reverse().slice(0, 8));
    };
    loadProducts();
  }, []);

  const handleCategorySelect = (categoryId: string) => {
    setSelectedCategory(categoryId);
    if (categoryId === 'Todos') {
      router.push('/catalogo');
    } else {
      router.push(`/catalogo?category=${encodeURIComponent(categoryId)}`);
    }
  };

  const handleAddToCart = (product: Product) => {
    addItem(
      {
        id: product.id,
        title: product.title,
        price: product.price,
        image: product.images[0] || FALLBACK_INDUSTRIAL_SVG,
      },
      1
    );
    toggleCart();
  };

  const formatPrice = (usdPrice: number) => {
    if (currency === 'VES' && bcvRate > 0) {
      return `Bs. ${(usdPrice * bcvRate).toLocaleString('es-VE', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      })}`;
    }
    if (currency === 'USDT') {
      return `${usdPrice.toFixed(2)} USDT`;
    }
    return `${siteConfig.currencySymbol}${usdPrice.toFixed(2)}`;
  };

  return (
    <main className="min-h-screen bg-transparent pb-20 overflow-hidden">
      {/* 1. HERO A PANTALLA COMPLETA */}
      <HeroCarousel />

      {/* 2. LÁMINA CON PIEL DE ROBOT Y BISEL HUECO NEÓN */}
      <div className="lamina-blanca bg-robot-skin chasis-bisel -mt-16 sm:-mt-24 md:-mt-32 pt-6 sm:pt-8 pb-14 mx-0 sm:mx-2 md:mx-4">
        
        {/* DOCK DE CATEGORÍAS ADENTRO DE LA LÁMINA BLANCA */}
        <div className="w-full px-2 sm:px-6 md:px-12 lg:px-16 xl:px-20 mb-2">
          <CategoryDock
            onSelect={handleCategorySelect}
            selectedCategory={selectedCategory}
          />
        </div>

        {/* PRIMER CARRUSEL */}
        

<ProductCarousel
          title="Equipos Destacados"
          categoryId="Todos"
          products={featuredProducts}
          formatPrice={formatPrice}
          handleAddToCart={handleAddToCart}
        />

        {/* CARRUSEL DE OFERTAS (Menos redondeado y alineado en móvil) */}
        <div className="w-full px-2 sm:px-6 md:px-12 lg:px-16 xl:px-20 py-4 sm:py-6">
          <OffersCarousel />
        </div>

        {/* SEGUNDO CARRUSEL */}
        

<ProductCarousel
          title="Novedades Industriales"
          categoryId="Todos"
          products={catalogProducts}
          formatPrice={formatPrice}
          handleAddToCart={handleAddToCart}
        />
      </div>
    </main>
  );
}
</file>

<file path="src/components/CategoryDock.tsx">
'use client';

import { useRef, useState, useEffect } from 'react';
import {
  Zap, BatteryCharging, Sun, Cable, Wrench, Shield, LayoutGrid, ChevronLeft, ChevronRight,
} from 'lucide-react';
import { siteConfig } from '@/config/site';

interface CategoryDockProps {
  onSelect: (id: string) => void;
  selectedCategory?: string;
}

const iconMap: Record<string, any> = {
  LayoutGrid, Zap, BatteryCharging, Sun, Cable, Wrench, Shield,
};

export function CategoryDock({
  onSelect,
  selectedCategory = 'Todos',
}: CategoryDockProps) {
  const scrollRef = useRef<HTMLDivElement>(null);
  
  // Sincronización en vivo con el Administrador
  const [categories, setCategories] = useState<any[]>(siteConfig.categories);

  useEffect(() => {
    if (typeof window !== 'undefined') {
      const localCats = localStorage.getItem('kva_categories_db');
      if (localCats) {
        try {
          const parsed = JSON.parse(localCats);
          if (Array.isArray(parsed) && parsed.length > 0) {
            const hasTodos = parsed.some((c: any) => c.id === 'Todos');
            if (!hasTodos) {
              setCategories([{ id: 'Todos', name: 'Catálogo Completo', shortName: 'Todos', slug: 'todos', iconName: 'LayoutGrid', image: '' }, ...parsed]);
            } else {
              setCategories(parsed);
            }
          }
        } catch (e) {}
      }
    }
  }, []);

  const scroll = (direction: 'left' | 'right') => {
    if (scrollRef.current) {
      const scrollAmount = 280;
      scrollRef.current.scrollBy({
        left: direction === 'left' ? -scrollAmount : scrollAmount,
        behavior: 'smooth',
      });
    }
  };

  return (
    <div className="relative w-full flex items-center">
      <button
        type="button"
        onClick={() => scroll('left')}
        aria-label="Desplazar categorías a la izquierda"
        className="absolute left-0 top-1/2 -translate-y-1/2 z-30 w-10 h-10 sm:w-11 sm:h-11 rounded-full liquid-glass-dark text-cyan-400 hover:text-white flex items-center justify-center cursor-pointer shadow-lg active:scale-95"
      >
        <ChevronLeft className="w-5 h-5" />
      </button>

      <div
        ref={scrollRef}
        className="w-full overflow-x-auto scrollbar-hide py-6 px-12 sm:px-14 scroll-smooth"
      >
        <div className="flex items-center justify-start lg:justify-between gap-3 sm:gap-4 min-w-max">
          {categories.map((item) => {
            const Icon = iconMap[item.iconName || 'Zap'] || Zap;
            const isSelected = selectedCategory.toUpperCase() === item.id.toUpperCase();

            return (
              <button
                key={`dock-cat-${item.id}`}
                type="button"
                onClick={() => onSelect(item.id)}
                className={`group flex items-center gap-2.5 px-5 sm:px-6 py-3.5 sm:py-4 text-xs sm:text-[13px] font-black uppercase tracking-wider transition-all duration-300 cursor-pointer active:scale-95 flex-shrink-0 rounded-full hover:-translate-y-1 ${
                  isSelected
                    ? 'liquid-glass-active text-white'
                    : 'liquid-glass-dark text-slate-200 hover:text-white'
                }`}
              >
                <Icon
                  className={`w-4 h-4 sm:w-5 sm:h-5 flex-shrink-0 transition-transform duration-300 group-hover:scale-110 ${
                    isSelected ? 'text-white' : 'text-cyan-400'
                  }`}
                />
                <span className="whitespace-nowrap">{item.shortName || item.name}</span>
              </button>
            );
          })}
        </div>
      </div>

      <button
        type="button"
        onClick={() => scroll('right')}
        aria-label="Desplazar categorías a la derecha"
        className="absolute right-0 top-1/2 -translate-y-1/2 z-30 w-10 h-10 sm:w-11 sm:h-11 rounded-full liquid-glass-dark text-cyan-400 hover:text-white flex items-center justify-center cursor-pointer shadow-lg active:scale-95"
      >
        <ChevronRight className="w-5 h-5" />
      </button>
    </div>
  );
}
</file>

<file path="src/components/Header.tsx">
'use client';

import { useState, useEffect, Suspense, FormEvent } from 'react';
import Link from 'next/link';
import { usePathname, useRouter, useSearchParams } from 'next/navigation';
import {
  SearchIcon,
  ShoppingCart,
  User,
  Menu,
  X,
  Zap,
  BatteryCharging,
  Sun,
  Cable,
  Wrench,
  Shield,
  LayoutGrid,
  ChevronRight,
  MapPin,
  MessageCircle,
  Sparkles,
} from 'lucide-react';
import { useCartStore } from '@/store/cartStore';
import { siteConfig } from '@/config/site';
import AuthModal from './AuthModal';

const iconMap: Record<string, any> = {
  LayoutGrid,
  Zap,
  BatteryCharging,
  Sun,
  Cable,
  Wrench,
  Shield,
};

function HeaderContent() {
  const pathname = usePathname();
  const router = useRouter();
  const searchParams = useSearchParams();

  const {
    toggleCart,
    items,
    currency,
    setCurrency,
    bcvRate,
    setBcvRate,
    usdtRate,
    setUsdtRate,
  } = useCartStore();

  const cartItemsCount = items.reduce((acc, item) => acc + item.quantity, 0);

  const [isScrolled, setIsScrolled] = useState(false);
  const [isMenuOpen, setIsMenuOpen] = useState(false);
  const [isAuthOpen, setIsAuthOpen] = useState(false);
  const [searchQuery, setSearchQuery] = useState('');

  const [categories, setCategories] = useState<any[]>(siteConfig.categories);
  const [branding, setBranding] = useState({
    logoWhite: siteConfig.branding.logoWhite,
    logoDark: siteConfig.branding.logoDark,
  });

  const isHomePage = pathname === '/';
  const useLightHeader = isScrolled || !isHomePage;

  useEffect(() => {
    const handleScroll = () => {
      setIsScrolled(window.scrollY > 40);
    };
    handleScroll();
    window.addEventListener('scroll', handleScroll, { passive: true });
    return () => window.removeEventListener('scroll', handleScroll);
  }, []);

  useEffect(() => {
    fetch('/api/bcv')
      .then((res) => res.json())
      .then((data) => {
        if (data.rate) setBcvRate(Number(data.rate));
      })
      .catch(() => {});

    fetch('/api/binance')
      .then((res) => res.json())
      .then((data) => {
        if (data.rate) setUsdtRate(Number(data.rate));
      })
      .catch(() => {});
  }, [setBcvRate, setUsdtRate]);

  useEffect(() => {
    if (typeof window !== 'undefined') {
      const localBrand = localStorage.getItem('kva_branding_db');
      if (localBrand) {
        try {
          const pb = JSON.parse(localBrand);
          setBranding({ 
            logoWhite: pb.logo_white || siteConfig.branding.logoWhite, 
            logoDark: pb.logo_dark || siteConfig.branding.logoDark 
          });
        } catch (e) {}
      }

      const localCats = localStorage.getItem('kva_categories_db');
      if (localCats) {
        try {
          const pc = JSON.parse(localCats);
          if (Array.isArray(pc) && pc.length > 0) {
            const hasTodos = pc.some((c: any) => c.id === 'Todos');
            if (!hasTodos) {
              setCategories([{ id: 'Todos', name: 'Catálogo Completo', shortName: 'Todos', slug: 'todos', iconName: 'LayoutGrid', image: '' }, ...pc]);
            } else {
              setCategories(pc);
            }
          }
        } catch (e) {}
      }
    }
  }, []);

  useEffect(() => {
    if (typeof window !== 'undefined') {
      window.dispatchEvent(
        new CustomEvent('bk-menu-toggle', { detail: { isOpen: isMenuOpen } })
      );
    }
  }, [isMenuOpen]);

  useEffect(() => {
    setIsMenuOpen(false);
  }, [pathname, searchParams]);

  if (pathname?.startsWith('/admin')) return null;

  const activeRateDisplay = () => {
    if (currency === 'VES') {
      return `Tasa BCV Oficial: Bs. ${bcvRate > 0 ? bcvRate.toFixed(2) : 'Sincronizando...'}`;
    }
    if (currency === 'USDT') {
      return `Tasa Binance P2P: ${usdtRate > 0 ? usdtRate.toFixed(2) : 'Sincronizando...'} Bs/USDT`;
    }
    return `Moneda Base: Dólar (${siteConfig.currencySymbol} USD)${
      bcvRate > 0 ? ` • BCV: Bs. ${bcvRate.toFixed(2)}` : ''
    }`;
  };

  const handleSearchSubmit = (e: FormEvent) => {
    e.preventDefault();
    const trimmed = searchQuery.trim();
    if (!trimmed) {
      router.push('/catalogo');
      return;
    }
    router.push(`/catalogo?q=${encodeURIComponent(trimmed)}`);
    setIsMenuOpen(false);
  };

  const whatsappClean = String(
    siteConfig.whatsapp?.number || siteConfig.contact.whatsapp || ''
  ).replace(/\D/g, '');

  return (
    <>
      <div className="w-full bg-[#07090E] border-b border-white/10 px-4 md:px-6 h-[36px] flex items-center z-50 fixed top-0 left-0 right-0">
        <div className="flex items-center justify-between w-full gap-2">
          <div className="flex items-center gap-2 min-w-0">
            <span className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse flex-shrink-0" />
            <span className="text-[11px] sm:text-xs font-bold text-slate-200 truncate">
              {activeRateDisplay()}
            </span>
          </div>

          <div className="flex items-center gap-1.5 sm:gap-2.5 text-[10px] sm:text-[11px] font-black tracking-wider flex-shrink-0">
            <span className="hidden md:inline text-slate-500 uppercase mr-1">
              Moneda:
            </span>
            <button
              type="button"
              onClick={() => setCurrency('USD')}
              className={`px-2 py-0.5 rounded-md transition-all cursor-pointer ${
                currency === 'USD'
                  ? 'bg-blue-600/20 text-cyan-300 border border-blue-500/50 shadow-[0_0_10px_rgba(37,99,235,0.25)]'
                  : 'text-slate-400 hover:text-white'
              }`}
            >
              USD
            </button>
            <span className="text-slate-700">|</span>
            <button
              type="button"
              onClick={() => setCurrency('VES')}
              className={`px-2 py-0.5 rounded-md transition-all cursor-pointer ${
                currency === 'VES'
                  ? 'bg-blue-600/20 text-cyan-300 border border-blue-500/50 shadow-[0_0_10px_rgba(37,99,235,0.25)]'
                  : 'text-slate-400 hover:text-white'
              }`}
            >
              VES (BCV)
            </button>
            <span className="text-slate-700">|</span>
            <button
              type="button"
              onClick={() => setCurrency('USDT')}
              className={`px-2 py-0.5 rounded-md transition-all cursor-pointer ${
                currency === 'USDT'
                  ? 'bg-amber-400/20 text-amber-300 border border-amber-400/50 shadow-[0_0_10px_rgba(251,191,36,0.25)]'
                  : 'text-slate-400 hover:text-amber-300'
              }`}
            >
              USDT
            </button>
          </div>
        </div>
      </div>

      <header
        className={`fixed top-[36px] left-0 right-0 z-40 transition-all duration-300 ${
          useLightHeader
            ? 'liquid-glass-light py-3 md:py-3.5'
            : 'bg-gradient-to-b from-[#07090E]/95 via-[#07090E]/75 to-transparent py-4 md:py-6'
        }`}
      >
        <div className="w-full px-4 md:px-6 flex items-center justify-between gap-4 md:gap-8">
          <Link
            href="/"
            className="flex items-center gap-3 flex-shrink-0 group cursor-pointer focus:outline-none"
          >
            <img
              src={
                useLightHeader
                  ? branding.logoDark
                  : branding.logoWhite
              }
              alt={siteConfig.name}
              className="h-14 sm:h-16 md:h-18 w-auto object-contain transition-all duration-300 group-hover:scale-105 drop-shadow-lg md:scale-[1.2] origin-left"
            />
          </Link>

          <form
            onSubmit={handleSearchSubmit}
            className="hidden md:flex flex-1 max-w-3xl items-center gap-3 mx-2 lg:mx-6"
          >
            <div className="relative flex-1 h-11 lg:h-12">
              <input
                type="search"
                value={searchQuery}
                onChange={(e) => setSearchQuery(e.target.value)}
                placeholder="Buscar transformadores, luminarias, plantas, conductores..."
                className={`w-full h-full pl-12 pr-6 text-xs lg:text-sm font-medium rounded-full outline-none transition-all ${
                  useLightHeader
                    ? 'liquid-glass-input-light text-slate-900 placeholder-slate-400'
                    : 'liquid-glass-input text-white placeholder-white/50'
                }`}
              />
              <SearchIcon
                className={`absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 lg:w-5 lg:h-5 z-10 ${
                  useLightHeader ? 'text-slate-400' : 'text-cyan-400'
                }`}
              />
            </div>
            <button
              type="submit"
              className="h-11 lg:h-12 px-6 lg:px-8 rounded-full liquid-glass-active text-white text-[10px] lg:text-xs font-black uppercase tracking-wider cursor-pointer flex items-center justify-center flex-shrink-0"
            >
              <span>Buscar</span>
            </button>
          </form>

          <div className="flex items-center justify-end gap-2.5 sm:gap-4 flex-shrink-0">
            <button
              type="button"
              onClick={() => setIsAuthOpen(true)}
              className={`hidden sm:flex items-center gap-2 px-4 lg:px-6 py-2.5 lg:py-3 rounded-full cursor-pointer ${
                useLightHeader
                  ? 'bg-slate-900/5 hover:bg-slate-900/10 text-slate-900 border border-slate-300/80 font-bold transition-all'
                  : 'liquid-glass-dark text-white font-bold'
              }`}
            >
              <User className="w-4 h-4 text-cyan-400" />
              <span className="text-xs lg:text-sm uppercase tracking-wider">Cuenta</span>
            </button>

            <button
              type="button"
              onClick={toggleCart}
              className="flex items-center gap-2 px-4 sm:px-6 py-2.5 lg:py-3 liquid-glass-active text-white rounded-full relative cursor-pointer"
              aria-label="Abrir carrito"
            >
              <ShoppingCart className="w-4 h-4 lg:w-5 lg:h-5" />
              <span className="hidden sm:block text-xs lg:text-sm font-black uppercase tracking-wider">
                Carrito
              </span>
              {cartItemsCount > 0 && (
                <span className="absolute -top-1.5 -right-1.5 bg-yellow-400 text-slate-950 text-[10px] lg:text-xs w-5 h-5 lg:w-6 lg:h-6 rounded-full flex items-center justify-center font-black border-2 border-white shadow-lg">
                  {cartItemsCount}
                </span>
              )}
            </button>

            <button
              type="button"
              onClick={() => setIsMenuOpen(true)}
              className={`p-2.5 sm:px-4 sm:py-2.5 lg:py-3 rounded-full flex items-center gap-2 cursor-pointer ${
                useLightHeader
                  ? 'bg-slate-900 text-white shadow-md hover:bg-slate-800 transition-all'
                  : 'liquid-glass-dark text-white'
              }`}
              aria-label="Abrir menú"
            >
              <Menu className="w-5 h-5 lg:w-6 lg:h-6 text-cyan-400" />
              <span className="hidden xl:inline text-[11px] lg:text-xs font-black uppercase tracking-wider pr-1">
                Menú
              </span>
            </button>
          </div>
        </div>
      </header>

      {isMenuOpen && (
        <div
          className="fixed inset-0 bg-slate-950/60 backdrop-blur-xs z-[110] transition-opacity"
          onClick={() => setIsMenuOpen(false)}
        />
      )}

      <aside
        className={`fixed top-0 right-0 h-full w-[320px] sm:w-[380px] max-w-[85vw] bg-[#0A0E17]/95 backdrop-blur-2xl border-l border-white/15 shadow-[-20px_0_50px_rgba(0,0,0,0.7)] z-[120] transform transition-transform duration-300 ease-out flex flex-col ${
          isMenuOpen ? 'translate-x-0' : 'translate-x-full'
        }`}
      >
        <div className="flex items-center justify-between px-5 py-4 border-b border-white/10 bg-[#07090E]">
          <Link
            href="/"
            onClick={() => setIsMenuOpen(false)}
            className="flex items-center gap-2.5"
          >
            <img
              src={branding.logoWhite}
              alt={siteConfig.name}
              className="h-10 w-auto object-contain scale-[1.1] origin-left"
            />
          </Link>
          <button
            type="button"
            onClick={() => setIsMenuOpen(false)}
            className="p-2.5 rounded-full liquid-glass-dark text-slate-300 hover:text-white transition-colors cursor-pointer"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        <div className="flex-1 overflow-y-auto px-5 py-5 space-y-8 scrollbar-hide">
          <form
            onSubmit={handleSearchSubmit}
            className="relative flex items-center gap-2"
          >
            <div className="relative flex-1 h-12">
              <input
                type="search"
                value={searchQuery}
                onChange={(e) => setSearchQuery(e.target.value)}
                placeholder="Buscar equipo o potencia..."
                className="w-full h-full pl-11 pr-4 rounded-full liquid-glass-input text-xs text-white placeholder-slate-400 focus:outline-none"
              />
              <SearchIcon className="w-4 h-4 text-cyan-400 absolute left-4 top-1/2 -translate-y-1/2 z-10" />
            </div>
            <button
              type="submit"
              className="h-12 px-5 rounded-full liquid-glass-active text-white text-[10px] font-black uppercase tracking-wider flex items-center justify-center flex-shrink-0 cursor-pointer"
            >
              <span>Ir</span>
            </button>
          </form>

          <div>
            <div className="flex items-center justify-between mb-4 px-1">
              <span className="text-[10px] font-black uppercase tracking-widest text-cyan-400">
                Departamentos Industriales
              </span>
              <Sparkles className="w-3.5 h-3.5 text-cyan-400" />
            </div>

            <div className="flex flex-col space-y-3">
              {categories.map((cat) => {
                const IconComponent = iconMap[cat.iconName || 'Zap'] || Zap;
                const href =
                  cat.id === 'Todos'
                    ? '/catalogo'
                    : `/catalogo?category=${encodeURIComponent(cat.id)}`;

                return (
                  <Link
                    key={`drawer-cat-${cat.id}`}
                    href={href}
                    onClick={() => setIsMenuOpen(false)}
                    className="group flex items-center justify-between px-4 py-3.5 liquid-glass-dark text-slate-200 hover:text-white transition-all"
                  >
                    <div className="flex items-center gap-3 min-w-0">
                      <IconComponent className="w-4 h-4 text-cyan-400 group-hover:text-white transition-colors flex-shrink-0" />
                      <span className="text-xs font-bold truncate">
                        {cat.name}
                      </span>
                    </div>
                    <ChevronRight className="w-4 h-4 text-cyan-400/50 group-hover:text-cyan-300 transition-all flex-shrink-0" />
                  </Link>
                );
              })}
            </div>
          </div>

          <div className="pt-2 border-t border-white/10">
            <span className="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-4 px-1">
              Secciones de la Tienda
            </span>
            <div className="flex flex-col space-y-3">
              {siteConfig.navigation.map((navItem) => (
                <Link
                  key={`drawer-nav-${navItem.href}`}
                  href={navItem.href}
                  onClick={() => setIsMenuOpen(false)}
                  className="flex items-center justify-between px-4 py-3.5 liquid-glass-dark text-xs font-bold text-slate-300 hover:text-white transition-all"
                >
                  <span>{navItem.name}</span>
                  <ChevronRight className="w-4 h-4 text-cyan-400/50" />
                </Link>
              ))}

              <button
                type="button"
                onClick={() => {
                  setIsMenuOpen(false);
                  setIsAuthOpen(true);
                }}
                className="flex items-center justify-between px-4 py-3.5 liquid-glass-dark text-xs font-bold text-slate-300 hover:text-white transition-all w-full text-left cursor-pointer"
              >
                <span className="flex items-center gap-2">
                  <User className="w-4 h-4 text-cyan-400" /> Mi Cuenta / Acceso
                </span>
                <ChevronRight className="w-4 h-4 text-cyan-400/50" />
              </button>
            </div>
          </div>
        </div>

        <div className="p-4 border-t border-white/10 bg-[#07090E] space-y-4">
          <div className="flex items-start gap-2.5 text-[11px] text-slate-400">
            <MapPin className="w-4 h-4 text-cyan-400 flex-shrink-0 mt-0.5" />
            <span>{siteConfig.location}</span>
          </div>

          <a
            href={`https://wa.me/${whatsappClean}?text=${encodeURIComponent(
              siteConfig.whatsapp.defaultMessage
            )}`}
            target="_blank"
            rel="noreferrer"
            className="w-full py-4 px-4 liquid-glass-active text-white font-black text-xs uppercase tracking-wider flex items-center justify-center gap-2 shadow-lg"
          >
            <MessageCircle className="w-5 h-5" /> Atención por WhatsApp
          </a>
        </div>
      </aside>

      <AuthModal isOpen={isAuthOpen} onClose={() => setIsAuthOpen(false)} />
    </>
  );
}

export default function Header() {
  return (
    <Suspense fallback={<div className="h-24 w-full bg-transparent" />}>
      <HeaderContent />
    </Suspense>
  );
}
</file>

