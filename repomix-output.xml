    background-size: 100% 100%, 1440px 960px;
    background-repeat: no-repeat, repeat;
    background-position: center top, center top;
  }

  /* 💎 LÁMINA PRINCIPAL SUPERPUESTA AL HERO */
  .lamina-blanca {
    position: relative;
    z-index: 30;
    border-top-left-radius: 1.5rem;
    border-top-right-radius: 1.5rem;
    border-bottom-left-radius: 1.5rem;
    border-bottom-right-radius: 1.5rem;
    box-shadow: 0 -18px 45px -10px rgba(5, 10, 24, 0.78);
  }

  /* 💎 BISEL HENDIDO CON PULSO DE LUZ NEÓN PEQUEÑO Y LENTO (14s) */
  .chasis-bisel {
    position: relative;
    box-shadow:
      0 -18px 45px -10px rgba(5, 10, 24, 0.7),
      inset 0 0 0 4px #CBD5E1,
      inset 0 4px 9px rgba(5, 10, 24, 0.28),
      inset 0 -4px 9px rgba(5, 10, 24, 0.22),
      inset 4px 0 9px rgba(5, 10, 24, 0.22),
      inset -4px 0 9px rgba(5, 10, 24, 0.22),
      inset 0 0 0 1px rgba(255, 255, 255, 0.95);
  }

  .chasis-bisel::after {
    content: "";
    position: absolute;
    inset: 1px;
    border-radius: inherit;
    padding: 2.5px;
    /* Destello pequeño y concentrado (solo entre 48% y 52%) para que se vea viajar sin encender todo el bisel */
    background: linear-gradient(
      115deg,
      rgba(15, 23, 42, 0.08) 0%,
      rgba(15, 23, 42, 0.08) 46.5%,
      rgba(0, 110, 255, 0.65) 48.5%,
      #00E5FF 49.6%,
      #FFFFFF 50%,
      #00E5FF 50.4%,
      rgba(0, 110, 255, 0.65) 51.5%,
      rgba(15, 23, 42, 0.08) 53.5%,
      rgba(15, 23, 42, 0.08) 100%
    );
    background-size: 350% 350%;
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    animation: neon-circuit-flow 14s linear infinite;
    z-index: 45;
  }

  /* 💎 1. TRUE WET LIQUID GLASS DARK (VIDRIO LÍQUIDO PULIDO Y BRILLANTE) */
  .liquid-glass-dark:where(:not(.absolute):not(.fixed):not(.sticky)) {
    position: relative;
  }

  .liquid-glass-dark {
    background:
      radial-gradient(120% 100% at 50% 100%, rgba(0, 195, 255, 0.28) 0%, rgba(0, 68, 255, 0.14) 42%, rgba(4, 7, 15, 0.94) 85%),
      linear-gradient(180deg, #0B1222 0%, #04070F 65%, #07142B 100%);
    border: 1.5px solid rgba(255, 255, 255, 0.26);
    box-shadow:
      /* Borde superior de vidrio brillante */
      inset 0 1.5px 1px rgba(255, 255, 255, 0.85),
      /* Grosor lateral de cristal */
      inset 2px 0 5px rgba(0, 229, 255, 0.28),
      inset -2px 0 5px rgba(59, 130, 246, 0.28),
      /* Refracción gruesa inferior cian/azul dentro del vidrio */
      inset 0 -3px 5px rgba(0, 229, 255, 0.85),
      inset 0 -10px 20px rgba(0, 102, 255, 0.55),
      /* Sombra cáustica proyectada en la superficie inferior */
      0 12px 22px -6px rgba(2, 6, 23, 0.72),
      0 8px 18px -4px rgba(0, 180, 255, 0.35);
    overflow: hidden;
    transition: all 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* 💎 2. DOMO ESPECULAR HÚMEDO (EL REFLEJO BLANCO LISO DE VIDRIO) */
  .liquid-glass-dark::before,
  .liquid-glass-active::before,
  .liquid-glass-input::before {
    content: "";
    position: absolute;
    top: 2px;
    left: 5px;
    right: 5px;
    height: 45%;
    border-radius: inherit;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.76) 0%,
      rgba(255, 255, 255, 0.24) 48%,
      rgba(255, 255, 255, 0) 100%
    );
    pointer-events: none;
    z-index: 1;
  }

  .liquid-glass-dark:hover {
    border-color: rgba(125, 249, 255, 0.65);
    box-shadow:
      inset 0 1.5px 1.5px rgba(255, 255, 255, 0.95),
      inset 2px 0 6px rgba(0, 229, 255, 0.45),
      inset -2px 0 6px rgba(59, 130, 246, 0.45),
      inset 0 -3.5px 7px rgba(0, 229, 255, 1),
      inset 0 -12px 24px rgba(0, 110, 255, 0.72),
      0 14px 26px -5px rgba(2, 6, 23, 0.8),
      0 10px 24px -3px rgba(0, 210, 255, 0.52);
  }

  /* 💎 3. BOTÓN ACTIVO (TRUE WET LIQUID GLASS AZUL/CIAN) */
  .liquid-glass-active:where(:not(.absolute):not(.fixed):not(.sticky)) {
    position: relative;
  }

  .liquid-glass-active {
    background:
      radial-gradient(110% 100% at 50% 100%, rgba(0, 240, 255, 0.75) 0%, rgba(0, 102, 255, 0.92) 52%, rgba(0, 42, 165, 0.98) 100%);
    border: 1.5px solid rgba(255, 255, 255, 0.55);
    box-shadow:
      inset 0 1.5px 1.5px rgba(255, 255, 255, 0.95),
      inset 2px 0 6px rgba(165, 243, 252, 0.5),
      inset -2px 0 6px rgba(165, 243, 252, 0.5),
      inset 0 -3.5px 6px rgba(255, 255, 255, 0.75),
      inset 0 -9px 18px rgba(0, 229, 255, 0.9),
      0 12px 22px -5px rgba(0, 35, 120, 0.65),
      0 10px 24px -3px rgba(0, 195, 255, 0.58);
    overflow: hidden;
    transition: all 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .liquid-glass-active:hover {
    border-color: rgba(255, 255, 255, 0.85);
    box-shadow:
      inset 0 2px 2px rgba(255, 255, 255, 1),
      inset 0 -4px 8px rgba(255, 255, 255, 0.9),
      inset 0 -12px 22px rgba(0, 240, 255, 1),
      0 15px 28px -5px rgba(0, 45, 150, 0.75),
      0 12px 28px -2px rgba(0, 229, 255, 0.72);
  }

  /* Asegura que el texto e íconos dentro de los botones de cristal queden por encima del reflejo ::before */
  .liquid-glass-dark > *,
  .liquid-glass-active > * {
    position: relative;
    z-index: 2;
  }

  /* 💎 4. INPUTS Y BUSCADORES DE CRISTAL PULIDO */
  .liquid-glass-input:where(:not(.absolute):not(.fixed):not(.sticky)) {
    position: relative;
  }

  .liquid-glass-input {
    background: linear-gradient(180deg, rgba(10, 16, 30, 0.92) 0%, rgba(5, 9, 18, 0.96) 100%);
    border: 1.5px solid rgba(255, 255, 255, 0.22);
    box-shadow:
      inset 0 2px 5px rgba(0, 0, 0, 0.75),
      inset 0 -2px 5px rgba(0, 229, 255, 0.35),
      0 6px 16px -4px rgba(0, 0, 0, 0.45);
    transition: all 0.25s ease;
  }

  .liquid-glass-input:focus {
    border-color: rgba(0, 229, 255, 0.75);
    box-shadow:
      inset 0 2px 5px rgba(0, 0, 0, 0.8),
      inset 0 -2px 8px rgba(0, 229, 255, 0.65),
      0 0 18px rgba(0, 229, 255, 0.35);
  }

  .liquid-glass-input-light {
    background: linear-gradient(180deg, #E8EEF5 0%, #FFFFFF 100%);
    border: 1.5px solid rgba(255, 255, 255, 0.95);
    box-shadow:
      inset 0 2px 5px rgba(15, 23, 42, 0.1),
      inset 0 -2px 4px rgba(255, 255, 255, 0.9),
      0 6px 14px -4px rgba(15, 23, 42, 0.08);
    transition: all 0.25s ease;
  }

  .liquid-glass-input-light:focus {
    border-color: rgba(0, 102, 255, 0.6);
    background: #FFFFFF;
    box-shadow:
      inset 0 2px 4px rgba(15, 23, 42, 0.06),
      0 0 0 3px rgba(0, 102, 255, 0.18);
  }

  /* 💎 5. TARJETAS PERLADAS (CRISTAL BLANCO PULIDO CON BISEL LISO) */
  .liquid-glass-pearl:where(:not(.absolute):not(.fixed):not(.sticky)) {
    position: relative;
  }

  .liquid-glass-pearl {
    background: linear-gradient(165deg, rgba(255, 255, 255, 0.98) 0%, rgba(241, 245, 249, 0.94) 100%);
    border: 1.5px solid #FFFFFF;
    border-radius: 1rem;
    box-shadow:
      inset 0 2px 3px rgba(255, 255, 255, 1),
      inset 0 -3px 6px rgba(0, 102, 255, 0.08),
      0 12px 24px -6px rgba(15, 23, 42, 0.1),
      0 4px 10px -2px rgba(0, 68, 255, 0.06);
    transition: all 0.28s ease;
  }

  .liquid-glass-pearl:hover {
    transform: translateY(-3px);
    border-color: rgba(0, 229, 255, 0.55);
    box-shadow:
      inset 0 2px 4px rgba(255, 255, 255, 1),
      inset 0 -3px 8px rgba(0, 229, 255, 0.22),
      0 18px 30px -8px rgba(15, 23, 42, 0.15),
      0 8px 18px -4px rgba(0, 102, 255, 0.18);
  }

  /* 💎 6. HEADER CLARO EN SCROLL */
  .liquid-glass-light {
    background: rgba(244, 247, 251, 0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow:
      inset 0 -1px 0 rgba(255, 255, 255, 0.9),
      0 8px 25px -8px rgba(15, 23, 42, 0.14);
  }
}

