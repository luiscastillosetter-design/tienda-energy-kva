<file path="src/components/BottomNav.tsx">
'use client';

import { useState, useEffect } from 'react';
import Link from 'next/link';
import { useRouter, usePathname } from 'next/navigation';
import { Home, LayoutGrid, ShoppingBag, Zap, User } from 'lucide-react';
import { useCartStore } from '@/store/cartStore';
import AuthModal from './AuthModal';

export default function BottomNav() {
  const { items, toggleCart, isCartOpen } = useCartStore();
  const router = useRouter();
  const pathname = usePathname();
  const [isAuthOpen, setIsAuthOpen] = useState(false);
  const [isMenuOpen, setIsMenuOpen] = useState(false);
  
  const cartItemsCount = items.reduce((acc, item) => acc + item.quantity, 0);

  useEffect(() => {
    const handleMenuState = (e: CustomEvent) => {
      setIsMenuOpen(e.detail.isOpen);
    };
    window.addEventListener('bk-menu-toggle' as any, handleMenuState);
    return () => window.removeEventListener('bk-menu-toggle' as any, handleMenuState);
  }, []);

  // Ocultar en el panel Admin o cuando el menú lateral o el carrito están abiertos
  if (pathname?.startsWith('/admin') || isMenuOpen || isCartOpen) return null;

  const handleHomeClick = (e: React.MouseEvent) => {
    e.preventDefault();
    if (pathname === '/') {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else {
      router.push('/');
    }
  };

  return (
    <>
      <nav className="md:hidden fixed bottom-4 left-4 right-4 z-[45] liquid-glass-dark rounded-full px-2 py-1.5 shadow-2xl flex items-center justify-around border border-white/10">
        
        <button
          onClick={handleHomeClick}
          className={`flex flex-col items-center gap-1 p-2 transition-transform active:scale-95 cursor-pointer ${
            pathname === '/' ? 'text-blue-400' : 'text-slate-400 hover:text-blue-300'
          }`}
        >
