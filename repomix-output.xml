'use client';

import { useState, useEffect } from 'react';
import Link from 'next/link';
import { useRouter, usePathname } from 'next/navigation';
import { Home, LayoutGrid, ShoppingBag, Zap, User } from 'lucide-react';
import { useCartStore } from '@/store/cartStore';
import AuthModal from './AuthModal';

export default function BottomNav() {
  const { items, toggleCart, isCartOpen } = useCartStore();
  const router = useRouter();
  const pathname = usePathname();
  const [isAuthOpen, setIsAuthOpen] = useState(false);
  const [isMenuOpen, setIsMenuOpen] = useState(false);
  
  const cartItemsCount = items.reduce((acc, item) => acc + item.quantity, 0);

  useEffect(() => {
    const handleMenuState = (e: CustomEvent) => {
      setIsMenuOpen(e.detail.isOpen);
    };
    window.addEventListener('bk-menu-toggle' as any, handleMenuState);
    return () => window.removeEventListener('bk-menu-toggle' as any, handleMenuState);
  }, []);

  // Ocultar en el panel Admin o cuando el menú lateral o el carrito están abiertos
  if (pathname?.startsWith('/admin') || isMenuOpen || isCartOpen) return null;

  const handleHomeClick = (e: React.MouseEvent) => {
    e.preventDefault();
    if (pathname === '/') {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else {
      router.push('/');
    }
  };

  return (
    <>
      <nav className="md:hidden fixed bottom-4 left-4 right-4 z-[45] liquid-glass-dark rounded-full px-2 py-1.5 shadow-2xl flex items-center justify-around border border-white/10">
        
        <button
          onClick={handleHomeClick}
          className={`flex flex-col items-center gap-1 p-2 transition-transform active:scale-95 cursor-pointer ${
            pathname === '/' ? 'text-blue-400' : 'text-slate-400 hover:text-blue-300'
          }`}
        >
          <Home className={`w-5 h-5 ${pathname === '/' ? 'drop-shadow-[0_0_8px_rgba(59,130,246,0.8)]' : ''}`} />
          <span className="text-[9px] font-black uppercase tracking-wider">Inicio</span>
        </button>

        <Link
          href="/catalogo"
          className={`flex flex-col items-center gap-1 p-2 transition-transform active:scale-95 cursor-pointer ${
            pathname === '/catalogo' ? 'text-blue-400' : 'text-slate-400 hover:text-blue-300'
          }`}
        >
          <LayoutGrid className={`w-5 h-5 ${pathname === '/catalogo' ? 'drop-shadow-[0_0_8px_rgba(59,130,246,0.8)]' : ''}`} />
          <span className="text-[9px] font-black uppercase tracking-wider">Catálogo</span>
        </Link>

        {/* Botón Central Flotante para el Carrito */}
        <button
          onClick={() => toggleCart()}
          className="flex flex-col items-center justify-center -mt-8 relative cursor-pointer group"
          aria-label="Abrir carrito"
        >
          <div className="w-14 h-14 rounded-full liquid-glass-active flex items-center justify-center group-active:scale-95 transition-transform border-[3px] border-[#0A0E17]">
            <ShoppingBag className="w-6 h-6 text-white drop-shadow-md" />
            {cartItemsCount > 0 && (
              <span className="absolute -top-1 -right-1 bg-yellow-400 text-slate-900 text-[11px] w-6 h-6 rounded-full flex items-center justify-center font-black border-2 border-[#0A0E17] shadow-lg">
                {cartItemsCount}
              </span>
            )}
          </div>
        </button>

        <Link
          href="/#ofertas"
          className="flex flex-col items-center gap-1 p-2 text-slate-400 hover:text-blue-400 transition-transform active:scale-95 cursor-pointer"
        >
          <Zap className="w-5 h-5" />
          <span className="text-[9px] font-black uppercase tracking-wider">Ofertas</span>
        </Link>

        <button
          onClick={() => setIsAuthOpen(true)}
          className="flex flex-col items-center gap-1 p-2 text-slate-400 hover:text-blue-400 transition-transform active:scale-95 cursor-pointer"
        >
          <User className="w-5 h-5" />
          <span className="text-[9px] font-black uppercase tracking-wider">Cuenta</span>
        </button>
      </nav>

      <AuthModal isOpen={isAuthOpen} onClose={() => setIsAuthOpen(false)} />
    </>
  );
}
</file>

<file path="src/components/CartDrawer.tsx">
'use client';

import { useRouter } from 'next/navigation';
import { X, Plus, Minus, Trash2, ShoppingBag, ArrowRight, Truck } from 'lucide-react';
import { useCartStore } from '@/store/cartStore';
import { siteConfig } from '@/config/site';

export default function CartDrawer() {
  const router = useRouter();
  const { items, isCartOpen, toggleCart, updateQuantity, removeItem, currency, bcvRate, usdtRate } = useCartStore();

  const subtotalUSD = items.reduce((acc, item) => acc + item.price * item.quantity, 0);
  const freeShippingThreshold = siteConfig.freeShippingThreshold || 50; 
  const progress = Math.min(100, (subtotalUSD / freeShippingThreshold) * 100);
  const remainingUSD = Math.max(0, freeShippingThreshold - subtotalUSD);

  const handleCheckout = () => {
    toggleCart();
    router.push('/checkout');
  };

  const formatPrice = (usdPrice: number) => {
    if (currency === 'VES' && bcvRate > 0) {
      return `Bs. ${(usdPrice * bcvRate).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    }
    if (currency === 'USDT') {
      return `${usdPrice.toFixed(2)} USDT`;
    }
    return `${siteConfig.currencySymbol}${usdPrice.toFixed(2)}`;
  };

  return (
    <>
      {/* VELO DE FONDO */}
      {isCartOpen && (
        <div
          className="fixed inset-0 bg-slate-950/60 backdrop-blur-xs z-[140] transition-opacity"
          onClick={toggleCart}
        />
      )}

      {/* CAJÓN DEL CARRITO */}
      <div
        className={`fixed inset-y-0 right-0 w-full sm:w-[400px] max-w-[85vw] bg-[#0A0E17]/95 backdrop-blur-2xl border-l border-white/15 shadow-[-20px_0_50px_rgba(0,0,0,0.7)] z-[150] transform transition-transform duration-300 ease-out flex flex-col ${
          isCartOpen ? 'translate-x-0' : 'translate-x-full'
        }`}
      >
        {/* CABECERA */}
        <div className="flex items-center justify-between px-6 py-5 border-b border-white/10 bg-[#07090E]">
          <div className="flex items-center gap-3">
            <div className="p-2 liquid-glass-active rounded-full">
              <ShoppingBag className="w-4 h-4 text-white" />
            </div>
            <h2 className="text-sm font-black text-white uppercase tracking-wider">
              Tu Carrito ({items.reduce((acc, i) => acc + i.quantity, 0)})
            </h2>
          </div>
          <button 
            onClick={toggleCart} 
            className="p-2 rounded-full liquid-glass-dark text-slate-300 hover:text-white transition-colors cursor-pointer"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* BARRA DE PROGRESO DE ENVÍO GRATIS */}
        <div className="bg-blue-900/20 px-6 py-4 border-b border-blue-500/20 text-xs text-blue-200 font-medium shadow-inner">
          {remainingUSD > 0 ? (
            <p className="flex items-center gap-2">
              <Truck className="w-4 h-4 text-blue-400" />
              <span>Agrega <span className="font-black text-yellow-400">{formatPrice(remainingUSD)}</span> para envío nacional gratis.</span>
            </p>
          ) : (
            <p className="flex items-center gap-2 font-black text-yellow-400 tracking-wider uppercase">
              <Truck className="w-4 h-4" /> ¡Calificas para Envío Gratis!
            </p>
          )}
          <div className="w-full bg-[#07090E] h-1.5 rounded-full mt-3 overflow-hidden border border-white/5">
            <div 
              className="bg-blue-500 h-full transition-all duration-500 rounded-full shadow-[0_0_10px_rgba(37,99,235,0.8)]" 
              style={{ width: `${progress}%` }}
            />
          </div>
        </div>

        {/* LISTA DE PRODUCTOS */}
        <div className="flex-1 overflow-y-auto px-6 py-4 scrollbar-hide">
          {items.length === 0 ? (
            <div className="flex flex-col items-center justify-center h-full text-center py-12">
              <div className="w-20 h-20 liquid-glass-dark rounded-full flex items-center justify-center text-slate-500 mb-6 shadow-lg">
                <ShoppingBag className="w-8 h-8" />
              </div>
              <p className="text-lg font-black text-slate-200 mb-2">Tu carrito está vacío</p>
              <p className="text-xs font-medium text-slate-500 max-w-[200px]">Explora el catálogo y añade equipos industriales a tu orden.</p>
            </div>
          ) : (
            <div className="space-y-4">
              {items.map((item) => (
                <div key={item.id} className="flex gap-4 items-center border-b border-white/5 pb-4">
                  <div className="relative w-20 h-20 rounded-2xl overflow-hidden bg-white/90 border border-white/20 flex-shrink-0 flex items-center justify-center shadow-sm">
                    <img
                      src={item.image}
                      alt={item.title}
                      className="w-full h-full object-contain p-2"
                    />
                  </div>
                  <div className="flex-1 flex flex-col justify-between min-w-0">
                    <div>
                      <p className="text-xs font-bold text-slate-200 line-clamp-2 leading-snug">{item.title}</p>
                      <p className="text-sm font-black text-blue-400 mt-1">
                        {formatPrice(item.price)}
                      </p>
                    </div>
                    <div className="flex items-center justify-between mt-3">
                      <div className="flex items-center liquid-glass-dark rounded-lg overflow-hidden border border-white/10 h-8">
                        <button
                          onClick={() => updateQuantity(item.id, item.quantity - 1)}
                          className="w-8 h-full flex items-center justify-center text-slate-400 hover:text-white transition-colors cursor-pointer font-black"
                        >
                          <Minus className="w-3 h-3" />
                        </button>
                        <span className="text-xs font-black text-white w-6 text-center">
                          {item.quantity}
                        </span>
                        <button
                          onClick={() => updateQuantity(item.id, item.quantity + 1)}
                          className="w-8 h-full flex items-center justify-center text-slate-400 hover:text-white transition-colors cursor-pointer font-black"
                        >
                          <Plus className="w-3 h-3" />
                        </button>
                      </div>
                      <button
                        onClick={() => removeItem(item.id)}
                        className="text-slate-500 hover:text-red-500 transition-colors p-1.5 liquid-glass-dark rounded-lg cursor-pointer"
                        title="Eliminar del carrito"
                      >
                        <Trash2 className="w-4 h-4" />
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>

        {/* PIE DEL CARRITO: TOTALES Y CHECKOUT */}
        <div className="p-6 bg-[#07090E] border-t border-white/10">
          <div className="space-y-3 mb-6">
            <div className="flex items-center justify-between text-xs font-bold text-slate-400 uppercase tracking-wider">
              <span>Subtotal</span>
              <span className="text-slate-200">{formatPrice(subtotalUSD)}</span>
            </div>
            <div className="flex items-center justify-between text-xs font-bold text-slate-400 uppercase tracking-wider">
              <span>Envío</span>
              <span className={remainingUSD === 0 && items.length > 0 ? 'text-green-400' : 'text-blue-400'}>
                {remainingUSD === 0 && items.length > 0 ? 'GRATIS' : 'Calculado al final'}
              </span>
            </div>
            <div className="pt-3 border-t border-white/10 flex items-end justify-between">
              <span className="text-sm font-black text-white uppercase tracking-wider">Total</span>
              <span className="text-2xl font-black text-blue-500 drop-shadow-md">
                {formatPrice(subtotalUSD)}
              </span>
            </div>
          </div>
          
          <button
            onClick={handleCheckout}
            disabled={items.length === 0}
            className="w-full py-4 rounded-full font-black liquid-glass-active text-white transition-all disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer text-xs uppercase tracking-widest flex items-center justify-center gap-3"
          >
            Proceder al Pago <ArrowRight className="w-4 h-4" />
          </button>
        </div>
      </div>
    </>
  );
}
</file>

<file path="src/components/CategoryDock.tsx">
'use client';

import { useRef } from 'react';
import {
  Zap,
  BatteryCharging,
  Sun,
  Cable,
  Wrench,
  Shield,
  LayoutGrid,
  ChevronLeft,
  ChevronRight,
} from 'lucide-react';
import { siteConfig } from '@/config/site';

interface CategoryDockProps {
  onSelect: (id: string) => void;
  selectedCategory?: string;
}

const iconMap = {
  LayoutGrid,
  Zap,
  BatteryCharging,
  Sun,
  Cable,
  Wrench,
  Shield,
};

export function CategoryDock({
  onSelect,
  selectedCategory = 'Todos',
}: CategoryDockProps) {
  const scrollRef = useRef<HTMLDivElement>(null);

  const scroll = (direction: 'left' | 'right') => {
    if (scrollRef.current) {
      const scrollAmount = 280;
      scrollRef.current.scrollBy({
        left: direction === 'left' ? -scrollAmount : scrollAmount,
        behavior: 'smooth',
      });
    }
  };

  return (
    <div className="relative w-full flex items-center">
      {/* Flecha Izquierda Fija al Extremo Izquierdo */}
      <button
        type="button"
        onClick={() => scroll('left')}
        aria-label="Desplazar categorías a la izquierda"
        className="absolute left-0 top-1/2 -translate-y-1/2 z-30 w-10 h-10 sm:w-11 sm:h-11 rounded-full liquid-glass-dark text-cyan-400 hover:text-white flex items-center justify-center cursor-pointer shadow-lg active:scale-95"
      >
        <ChevronLeft className="w-5 h-5" />
      </button>

      {/* Carrilera con padding vertical py-6 para que las sombras inferiores nunca se corten */}
      <div
        ref={scrollRef}
        className="w-full overflow-x-auto scrollbar-hide py-6 px-12 sm:px-14 scroll-smooth"
      >
        <div className="flex items-center justify-start lg:justify-between gap-3 sm:gap-4 min-w-max">
          {siteConfig.categories.map((item) => {
            const Icon = iconMap[item.iconName] || Zap;
            const isSelected =
              selectedCategory.toUpperCase() === item.id.toUpperCase();

            return (
              <button
                key={`dock-cat-${item.id}`}
                type="button"
                onClick={() => onSelect(item.id)}
                className={`group flex items-center gap-2.5 px-5 sm:px-6 py-3.5 sm:py-4 text-xs sm:text-[13px] font-black uppercase tracking-wider transition-all duration-300 cursor-pointer active:scale-95 flex-shrink-0 rounded-full hover:-translate-y-1 ${
                  isSelected
                    ? 'liquid-glass-active text-white'
                    : 'liquid-glass-dark text-slate-200 hover:text-white'
                }`}
              >
                <Icon
                  className={`w-4 h-4 sm:w-5 sm:h-5 flex-shrink-0 transition-transform duration-300 group-hover:scale-110 ${
                    isSelected ? 'text-white' : 'text-cyan-400'
                  }`}
                />
                <span className="whitespace-nowrap">{item.shortName}</span>
              </button>
            );
          })}
        </div>
      </div>

      {/* Flecha Derecha Fija al Extremo Derecho */}
      <button
        type="button"
        onClick={() => scroll('right')}
        aria-label="Desplazar categorías a la derecha"
        className="absolute right-0 top-1/2 -translate-y-1/2 z-30 w-10 h-10 sm:w-11 sm:h-11 rounded-full liquid-glass-dark text-cyan-400 hover:text-white flex items-center justify-center cursor-pointer shadow-lg active:scale-95"
      >
        <ChevronRight className="w-5 h-5" />
      </button>
    </div>
  );
}
</file>

